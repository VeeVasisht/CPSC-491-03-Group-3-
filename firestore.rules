rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Authentication helpers
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }


    /*
     * User profiles
     *   Path: /users/{uid}
     *   Fields: displayName, bio, createdAt, updatedAt
     *   (uid is the document id — not stored in the doc)
     */

    match /users/{userId} {

      // Read only your own profile.
      allow read: if isOwner(userId);

      // Create your own profile: exactly the 4 expected fields, valid
      // lengths, and server timestamps.
      allow create: if
        isOwner(userId)

        && request.resource.data.keys().hasAll([
          'displayName', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'createdAt', 'updatedAt'
        ])

        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50

        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160

        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time

        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;

      // Update only displayName, bio, updatedAt. createdAt is immutable.
      allow update: if
        isOwner(userId)

        && request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['displayName', 'bio', 'updatedAt'])

        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50

        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160

        && request.resource.data.createdAt == resource.data.createdAt

        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;

      // Client-side deletion disabled.
      allow delete: if false;
    }


    /*
     * Default deny — any path not explicitly allowed above is blocked.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}