rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Authentication helpers
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }


    /*
     * User profiles
     *   Path: /users/{uid}
     *   Fields: displayName, bio, createdAt, updatedAt
     *   (uid is the document id — not stored in the doc)
     */

    match /users/{userId} {

      // Any signed-in user can read profiles: the feed shows each post's
      // author displayName. Writes below stay owner-only.
      allow read: if isSignedIn();

      // Create your own profile: exactly the 4 expected fields, valid
      // lengths, and server timestamps.
      allow create: if
        isOwner(userId)

        && request.resource.data.keys().hasAll([
          'displayName', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'createdAt', 'updatedAt'
        ])

        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50

        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160

        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time

        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;

      // Update only displayName, bio, updatedAt. createdAt is immutable.
      allow update: if
        isOwner(userId)

        && request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['displayName', 'bio', 'updatedAt'])

        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50

        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160

        && request.resource.data.createdAt == resource.data.createdAt

        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;

      // Client-side deletion disabled.
      allow delete: if false;
    }


    // Sprint 3 location updates must use the same validated Geotag shape as
    // app/models/geotag.ts. Older posts may legitimately have no location.
    function validPostLocation(data) {
      return !data.keys().hasAny(['location'])
        || data.location == null
        || (
          data.location is map
          && data.location.keys().hasAll(['name', 'latitude', 'longitude'])
          && data.location.keys().hasOnly(['name', 'latitude', 'longitude'])
          && data.location.name is string
          && data.location.name.size() > 0
          && data.location.latitude is number
          && data.location.latitude >= -90
          && data.location.latitude <= 90
          && data.location.longitude is number
          && data.location.longitude >= -180
          && data.location.longitude <= 180
        );
    }

    /*
     * Posts
     *   Path: /posts/{postId}
     *   Fields: authorId, title, description, imageUrl, createdAt, updatedAt
     */

    match /posts/{postId} {

      // Posts may be viewed by anyone.
      allow read: if true;

      // Signed-in users may create posts only for themselves.
      allow create: if
        isSignedIn()

        && request.resource.data.keys().hasAll([
          'authorId',
          'title',
          'description',
          'imageUrl',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'authorId',
          'title',
          'description',
          'imageUrl',
          'createdAt',
          'updatedAt',
          'location'
        ])

        && validPostLocation(request.resource.data)

        && request.resource.data.authorId is string
        && request.resource.data.authorId == request.auth.uid

        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100

        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000

        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0

        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time

        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;

      // Authors may edit post content, but cannot change ownership
      // or the original creation timestamp.
      allow update: if
        isSignedIn()
        && resource.data.authorId == request.auth.uid

        && request.resource.data.keys().hasOnly([
          'authorId',
          'title',
          'description',
          'imageUrl',
          'createdAt',
          'updatedAt',
          'location'
        ])
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'title',
            'description',
            'imageUrl',
            'updatedAt',
            'location'
          ])

        && validPostLocation(request.resource.data)

        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt

        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100

        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000

        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0

        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;

      // Only the post author may delete the post.
      allow delete: if
        isSignedIn()
        && resource.data.authorId == request.auth.uid;
    }


    /*
     * Default deny — any path not explicitly allowed above is blocked.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}