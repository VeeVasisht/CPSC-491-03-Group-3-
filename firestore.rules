rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // A user can only read their own profile.
      allow read: if isOwner(userId);

      // A user can only create a document whose ID matches
      // their Firebase Authentication UID.
      allow create: if isOwner(userId);

      // A user can only update their own profile.
      allow update: if isOwner(userId);

      // Don't let users delete their profile from the client yet.
      allow delete: if false;
    }

    // Everything not explicitly allowed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}