rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Authentication helpers
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }


    /*
     * User profiles
     *
     * Path:
     *   /users/{uid}
     *
     * Allowed fields:
     *   displayName : string
     *   bio         : string
     *   createdAt   : timestamp
     *   updatedAt   : timestamp
     */

    match /users/{userId} {

      /*
       * READ
       *
       * Users may only read their own profile.
       */

      allow read: if isOwner(userId);


      /*
       * CREATE
       *
       * A newly-created profile must:
       *   - belong to the signed-in user
       *   - contain exactly the four expected fields
       *   - have a non-empty display name
       *   - start with an empty bio
       *   - use server timestamps for createdAt and updatedAt
       */

      allow create: if
        isOwner(userId)

        && request.resource.data.keys().hasAll([
          'displayName',
          'bio',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasOnly([
          'displayName',
          'bio',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50

        && request.resource.data.bio is string
        && request.resource.data.bio == ""

        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time

        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;


      /*
       * UPDATE
       *
       * Users may update only:
       *   - displayName
       *   - bio
       *   - updatedAt
       *
       * createdAt is immutable.
       */

      allow update: if
        isOwner(userId)

        && request.resource.data.keys().hasOnly([
          'displayName',
          'bio',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'bio',
            'updatedAt'
          ])

        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50

        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500

        && request.resource.data.createdAt == resource.data.createdAt

        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;


      /*
       * DELETE
       *
       * Client-side profile deletion is disabled for now.
       */

      allow delete: if false;
    }


    /*
     * DEFAULT DENY
     *
     * Any collection or document not explicitly allowed above is blocked.
     */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}